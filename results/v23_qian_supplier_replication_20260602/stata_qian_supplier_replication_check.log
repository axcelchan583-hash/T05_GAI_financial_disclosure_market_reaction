. 
. foreach rel in upstream_supplier downstream_customer {
  2.     foreach var in ar_m1_mm ar_0_mm ar_p1_mm car_0_p1_mm car_m1_p1_mm {
  3.         quietly summarize `var' if relation == "`rel'", detail
  4.         scalar n = r(N)
  5.         scalar mean = r(mean)
  6.         scalar median = r(p50)
  7.         scalar se = .
  8.         scalar t = .
  9.         scalar p = .
 10.         if n > 1 & r(sd) > 0 {
 11.             scalar se = r(sd) / sqrt(n)
 12.             scalar t = mean / se
 13.             scalar p = 2 * ttail(n - 1, abs(t))
 14.         }
 15.         tempvar positive
 16.         quietly generate byte `positive' = (`var' > 0) if relation == "`re
> l'" & !missing(`var')
 17.         quietly summarize `positive' if relation == "`rel'" & !missing(`va
> r'), meanonly
 18.         scalar positive_rate = r(mean)
 19.         post `handle' ("`rel'") ("`var'") (n) (mean) (se) (t) (p) (median)
>  (positive_rate)
 20.         drop `positive'
 21.     }
 22. }

. postclose `handle'

